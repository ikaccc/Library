{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Grpc": {
        "Url": "http://localhost:5001",
        "Protocols": "Http2"
      },
      "Http": {
        "Url": "http://localhost:5002",
        "Protocols": "Http1"
      }
    }
  },
  "ConnectionStrings": {
    "Lending": "Host=localhost;Port=5433;Database=library;Username=library;Password=library"
  },
  "Database": {
    "MigrateOnStartup": true,
    "SeedOnStartup": true
  },
  "Lending": {
    "LoanPeriodDays": 14,
    "MaxOpenLoansPerBorrower": 5
  },
  "Otel": {
    "ServiceName": "Library.Lending.Grpc",
    "ServiceVersion": "1.0.0",
    "Endpoint": "http://localhost:18889"
  },
  "Grpc": {
    "Reflection": true
  }
}
